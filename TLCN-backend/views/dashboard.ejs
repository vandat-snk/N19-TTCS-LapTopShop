<% layout('base') -%>

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <h2 class="fw-bold m-0" style="color:#d63384;">
            Bảng điều khiển
        </h2>

    </div>

    <!-- Cards -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3" style="border-left: 4px solid #d63384 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Nhập hàng</div>
                        <h5 id="totalInvoice" class="fw-bold mb-0" style="color:#d63384;"></h5>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#fce4ec;">
                        <i class="fas fa-file-invoice" style="color:#d63384;font-size:18px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3" style="border-left: 4px solid #20c997 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Doanh thu</div>
                        <h5 id="totalRevenue" class="fw-bold mb-0" style="color:#20c997;"></h5>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#d4f5ed;">
                        <i class="fas fa-chart-line" style="color:#20c997;font-size:18px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3" style="border-left: 4px solid #6f42c1 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Người dùng</div>
                        <h5 id="totalUser" class="fw-bold mb-0" style="color:#6f42c1;"></h5>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#ede7f6;">
                        <i class="fas fa-users" style="color:#6f42c1;font-size:18px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3" style="border-left: 4px solid #fd7e14 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold mb-1">Đơn hàng</div>
                        <h5 id="totalOrder" class="fw-bold mb-0" style="color:#fd7e14;"></h5>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#fff3e0;">
                        <i class="fas fa-shopping-cart" style="color:#fd7e14;font-size:18px;"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Charts -->
    <div class="row g-3">

        <!-- Line / Area chart -->
        <div class="col-xl-8 col-lg-7">

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold m-0" style="color:#d63384;">
                        Tổng quan thống kê
                    </h6>
                    <div class="d-flex gap-3" style="font-size:12px;">
                        <span><span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#d63384;margin-right:5px;"></span>Thu nhập</span>
                        <span><span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#20c997;margin-right:5px;"></span>Chi phí</span>
                    </div>
                </div>

                <div class="card-body">
                    <canvas id="myAreaChart" style="height:260px;"></canvas>
                </div>

            </div>

        </div>

        <!-- Pie chart -->
        <div class="col-xl-4 col-lg-5">

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-header bg-white border-0">
                    <h6 class="fw-bold m-0" style="color:#d63384;">
                        Nguồn đơn hàng
                    </h6>
                </div>

                <div class="card-body">

                    <div class="chart-pie pt-2 pb-2" style="position:relative;height:220px;">
                        <canvas id="myPieChart"></canvas>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2 justify-content-center" style="font-size:12px;">

                        <span class="badge rounded-pill px-3 py-2" style="background:#dc3545;color:#fff;">
                            <i class="fas fa-circle me-1" style="font-size:9px;"></i> Huỷ
                        </span>

                        <span class="badge rounded-pill px-3 py-2" style="background:#fd7e14;color:#fff;">
                            <i class="fas fa-circle me-1" style="font-size:9px;"></i> Đang xử lý
                        </span>

                        <span class="badge rounded-pill px-3 py-2" style="background:#6c757d;color:#fff;">
                            <i class="fas fa-circle me-1" style="font-size:9px;"></i> Chờ hàng
                        </span>

                        <span class="badge rounded-pill px-3 py-2" style="background:#6f42c1;color:#fff;">
                            <i class="fas fa-circle me-1" style="font-size:9px;"></i> Giao hàng
                        </span>

                        <span class="badge rounded-pill px-3 py-2" style="background:#20c997;color:#fff;">
                            <i class="fas fa-circle me-1" style="font-size:9px;"></i> Thành công
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Chart JS giữ nguyên -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
<script src="js/dashboard.js"></script>
